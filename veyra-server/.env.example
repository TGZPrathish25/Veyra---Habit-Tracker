# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# Database (PostgreSQL Prisma connection URL)
DATABASE_URL=postgresql://veyra:veyra_dev@localhost:5432/veyra_dev

# Firebase Admin SDK (base64-encoded service account JSON)
FIREBASE_SERVICE_ACCOUNT=

# CORS — allowed client web origin
CLIENT_ORIGIN=http://localhost:5173

# Development Auth Fallback (allows local development when Firebase Auth credentials are not supplied)
ALLOW_DEV_AUTH=true

# Timezone fixed to India
APP_TIMEZONE=Asia/Kolkata

# Optional: Gemini AI API key for intelligent habit reflection and monthly reviews
GEMINI_API_KEY=
